---
import Analytics from "@vercel/analytics/astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Luca Silveira",
  description = "Product manager and business student interested in AI, global markets, logistics, marketplaces, and Brazil."
} = Astro.props;

const pageTitle = title === "Luca Silveira" ? title : `${title} — Luca Silveira`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navigation />
    <main class="site-container relative z-[1] py-8 sm:py-12">
      <slot />
    </main>
    <div class="relative z-[1]">
      <Footer />
    </div>
    <Analytics />
  </body>
</html>
