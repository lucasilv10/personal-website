---
const navItems = [
  { href: "/interview#life", label: "About", navKey: "about", newTab: false },
  { href: "/#projects", label: "Projects", navKey: "projects", newTab: false },
  { href: "/#experience", label: "Experience", navKey: "experience", newTab: false },
  { href: "/interview", label: "Life", navKey: "personal", newTab: false }
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pageKey = currentPath.startsWith("/projects") ? "projects"
  : currentPath.startsWith("/writing") ? "writing"
  : currentPath === "/interview" ? "personal"
  : "about";
---

<header class="site-container">
  <div class="site-header border-b border-rule">
    <a href="/" aria-label="Luca Silveira home" class="font-serif text-2xl font-semibold text-ink no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">LS.</a>
    <button type="button" class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-links">
      <span aria-hidden="true" class="menu-symbol"><span></span><span></span><span></span></span>
    </button>
    <nav id="primary-links" class="primary-links" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} target={item.newTab ? "_blank" : undefined} rel={item.newTab ? "noopener noreferrer" : undefined} data-nav-link={item.navKey} aria-current={pageKey === item.navKey ? "page" : undefined} class:list={["nav-link text-base text-muted no-underline hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4", pageKey === item.navKey && "is-active"]}>
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(#projects), :global(#experience), :global(#about-me) { scroll-margin-top: 84px; }
  .site-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; min-height: 68px; }
  .menu-toggle { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; color: #171717; }
  .menu-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .menu-symbol { display: flex; width: 20px; flex-direction: column; gap: 5px; }
  .menu-symbol span { height: 1px; width: 100%; background: currentColor; }
  .primary-links { display: none; width: 100%; padding-block: 8px 16px; }
  .primary-links.is-open { display: flex; flex-direction: column; }
  .nav-link { display: flex; min-height: 44px; align-items: center; transition: color 200ms ease-out; }
  .nav-label { position: relative; }
  .nav-label::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease-out;
  }
  .nav-link:is(:hover, :focus-visible) .nav-label::after { transform: scaleX(1); }
  .nav-link.is-active { color: #171717; font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .nav-link, .nav-label::after { transition: none; }
  }
  @media (min-width: 768px) {
    .site-header { flex-wrap: nowrap; }
    .menu-toggle { display: none; }
    .primary-links, .primary-links.is-open { display: flex; width: auto; flex-direction: row; gap: 24px; padding: 0; }
  }
  @media (min-width: 1024px) { .primary-links { gap: 32px; } }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#primary-links");
  const setMenu = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    navigation?.classList.toggle("is-open", open);
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && !event.target.closest(".site-header")) setMenu(false);
  });
  window.matchMedia("(min-width: 768px)").addEventListener("change", () => setMenu(false));

  if (window.location.pathname === "/") {
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-section]"));
    const updateActiveSection = () => {
      const marker = Math.min(window.innerHeight * 0.3, 220);
      const active = sections.filter((section) => section.getBoundingClientRect().top <= marker).pop();
      const key = active?.dataset.navSection || "about";
      document.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((link) => {
        const selected = link.dataset.navLink === key;
        link.classList.toggle("is-active", selected);
        if (selected) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    updateActiveSection();
    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("resize", updateActiveSection);
    window.addEventListener("load", updateActiveSection, { once: true });
  }
</script>
