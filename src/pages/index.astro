---
import Layout from "../components/Layout.astro";
import ArticleList from "../components/ArticleList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing"))
  .sort((a, b) => {
    const aUnpublished = a.data.readingTime === "TBD";
    const bUnpublished = b.data.readingTime === "TBD";

    if (aUnpublished !== bUnpublished) {
      return aUnpublished ? 1 : -1;
    }

    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);
const selectedProjects = projects.slice(0, 3);
const projectNotes = [
  {
    title: "WHOOP Experiments",
    image: "/images/projects/whoop-experiments.png",
    imageFit: "contain",
    experience: "WHOOP",
    description:
      "Designed and prototyped a WHOOP feature that helps members test personalized habits through seven-day challenges, Journal check-ins, and results recaps.",
    tools: ["Codex", "Figma Make", "React", "TypeScript"],
    resources: [
      { label: "Watch Demo", href: "https://www.youtube.com/watch?v=bmqujEWhcxI", primary: true },
      { label: "Product Brief", href: "/documents/whoop-experiments-product-brief.pdf", primary: false }
    ]
  },
  {
    title: "Tracking Page AI Summary",
    slug: "/projects/tracking-page-ai-summary",
    image: "/images/projects/tracking-page-dashboard.png",
    imageFit: "contain",
    experience: "Uber Freight",
    description:
      "An LLM-powered tracking-page experience that turns shipment events, ETA changes, and delay signals into a clear status narrative for customers.",
    tools: ["Figma", "Cursor", "Gemini API", "Tableau"],
    resources: [
      { label: "Watch Demo (2 min)", href: "https://www.youtube.com/watch?v=S9oXYqEwpTY&feature=youtu.be", primary: true },
      { label: "Product Brief", href: "/documents/ptp-ai-summary-prd.pdf", primary: false }
    ]
  },
  {
    title: "Shipment Risk Reasons",
    slug: "/projects/shipment-risk-reasons",
    image: "/images/projects/shipment-risk-dashboard.png",
    imageFit: "contain",
    experience: "Uber Freight",
    description:
      "An AI shipment visibility feature that scrapes carrier comments & shipment data to provide customer-facing explanations for load risk level.",
    tools: ["Nano Banana", "Cursor", "Python", "SQL"],
    resources: [
      { label: "Product Brief", href: "/documents/uber-risk-reasons-brief.pdf", primary: true }
    ]
  },
  {
    title: "Hiring Cost & ROI Calculator",
    image: "/images/projects/hiring-cost-calculator.png",
    experience: "Instawork",
    description:
      "An interactive calculator (gated content) page I ran LinkedIn ads to that helped recruiters understand hiring costs and estimate Instawork’s ROI, while collecting their lead info.",
    tools: ["Replit", "Hubspot", "Google Analytics"],
    resources: [
      { label: "Try Calculator", href: "https://hiringcalculator.instawork.com/", primary: true }
    ]
  },
  {
    title: "Job Posting",
    image: "/images/projects/job-posting-onboarding.png",
    experience: "Instawork",
    description:
      "A redesigned job posting flow that let employers preview listings, see local worker supply, and skip payment and login steps to reduce onboarding friction.",
    tools: ["Replit", "Hubspot", "A/B Testing"]
  }
];
const projectNoteStyles = [
  {
    paper: "bg-[#fcfbf7]",
    tape: "bg-[#e8e1d6]"
  },
  {
    paper: "bg-[#fbfaf6]",
    tape: "bg-[#ded8cf]"
  },
  {
    paper: "bg-[#fdfbf4]",
    tape: "bg-[#e7ddcb]"
  },
  {
    paper: "bg-[#fbfaf6]",
    tape: "bg-[#e5ded2]"
  }
];
---

<Layout
  title="About"
  description="About Luca Silveira: product manager and business student interested in AI, logistics, marketplaces, global markets, and Brazil."
>
  <section id="about-me" class="editorial-hero" data-nav-section="about" aria-label="About Luca">
    <div class="hero-portrait relative">
      <div class="absolute -left-3 -top-3 h-full w-full border border-ink/80" aria-hidden="true" />
      <img
        src="/images/luca-headshot.png"
        alt="Luca Silveira headshot"
        class="relative block h-auto w-full"
      />
    </div>
    <div class="hero-copy min-w-0">
      <h1 class="text-[17px] font-medium uppercase tracking-[0.12em] text-ink">Luca Silveira</h1>
      <h2 class="hero-tagline mt-3 font-semibold text-ink">
        From selling boats in Miami to building products at Uber
      </h2>
      <p class="mt-4 text-[18px] leading-[1.5] text-ink">
        I'm a senior at Michigan Ross studying business. This summer, I worked in product at Uber Freight, building AI and tracking features across $20B in freight under management. Previously, I worked on growth at Instawork, a labor marketplace startup, and started a boat dealership in high school. I'm Brazilian-American, grew up in Miami, and played MLS NEXT soccer growing up.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="https://drive.google.com/file/d/1mX4iaF9mPI-bvAcM6TBPuqD2AQYu9aj4/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 text-base font-medium text-ink underline decoration-rule underline-offset-4 hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M7 3h7l4 4v14H7zM14 3v5h5M9.5 13h5M9.5 16h5" />
          </svg>
          Resume
        </a>
        <a href="https://www.linkedin.com/in/luca-l-silveira/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 text-base font-medium text-ink underline decoration-rule underline-offset-4 hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">
          <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.9 8.7H3.8v11.1h3.1V8.7ZM5.4 4.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6Zm14.8 9.5c0-3-1.6-5.2-4.3-5.2-1.4 0-2.5.8-3 1.6h-.1V8.7h-3v11.1h3.1v-5.9c0-1.6.9-2.7 2.2-2.7 1.2 0 2 1 2 2.7v5.9h3.1v-6.1Z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section id="projects" class="mt-9 border-t border-ink pb-12 pt-6" data-nav-section="projects">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">Projects</h2>
    </div>
    <div class="space-y-8">
      {
        projectNotes.map((project, index) => {
          const noteStyle = projectNoteStyles[index % projectNoteStyles.length];
          const hasBrief = project.resources?.some((resource) => resource.label === "Product Brief");
          const card = (
          <article
            class:list={[
              "relative overflow-hidden border border-rule shadow-[0_1px_0_rgba(23,23,23,0.08),0_18px_38px_rgba(23,23,23,0.08)] transition duration-300 ease-out before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(135deg,rgba(255,255,255,0.72),rgba(255,255,255,0)_38%)] before:content-[''] group-hover:-translate-y-1 group-hover:border-ink group-hover:shadow-[0_1px_0_rgba(23,23,23,0.12),0_24px_48px_rgba(23,23,23,0.12)]",
              noteStyle.paper
            ]}
          >
            <span
              class:list={[
                "absolute left-8 top-0 z-[2] h-2 w-20 border-x border-b border-rule/70 opacity-85 shadow-[0_4px_10px_rgba(23,23,23,0.06)]",
                noteStyle.tape
              ]}
              aria-hidden="true"
            />
            <div class="project-layout relative z-[1] grid gap-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
              <div class="project-visual relative min-w-0 overflow-hidden border-b border-rule bg-paper lg:border-b-0 lg:border-r">
                <img
                  src={project.image}
                  alt={`${project.title} preview`}
                  class="absolute inset-0 h-full w-full object-contain object-center p-4 transition duration-300 ease-out group-hover:scale-[1.02] sm:p-6"
                />
                <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(247,244,238,0)_62%,rgba(247,244,238,0.52))] opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />
              </div>
              <div class="project-info relative flex min-w-0 items-center justify-center p-4 sm:p-5">
                <div class="relative w-full min-w-0 border border-rule bg-paper/90 p-4 shadow-[0_1px_0_rgba(23,23,23,0.08),0_14px_30px_rgba(23,23,23,0.08)] backdrop-blur-sm">
                  <div class="mb-5 grid grid-cols-[minmax(0,1fr)_1rem_auto] items-center gap-2">
                    <span class:list={["flex-none max-w-full rounded-md border border-rule bg-[#fbfaf6] px-2 py-1 text-[11px] uppercase tracking-[0.08em] text-muted shadow-[0_1px_0_rgba(23,23,23,0.08),0_6px_18px_rgba(23,23,23,0.04)] sm:tracking-[0.1em]", project.resources ? "min-w-0 whitespace-normal leading-4" : "whitespace-nowrap overflow-hidden text-ellipsis"]}>
                      {project.experience}
                    </span>
                    <span class="h-px min-w-0 bg-rule/90" aria-hidden="true" />
                    <span class="flex-none whitespace-nowrap pl-1 text-[11px] uppercase tracking-[0.14em] text-muted">
                      0{index + 1}
                    </span>
                  </div>
                  <h3 class="text-[22px] font-normal leading-tight text-ink">
                    {project.slug && project.resources ? (
                      <a href={project.slug} class="no-underline hover:underline focus-visible:outline focus-visible:outline-offset-4">{project.title}</a>
                    ) : project.title}
                  </h3>
                  <p class="mt-4 text-sm leading-6 text-muted">{project.description}</p>
                  {project.resources && (
                    <div class:list={["mt-5 flex flex-col items-start text-sm text-ink", hasBrief ? "gap-2.5" : "gap-3"]}>
                      {project.resources.map((resource) => (
                        <a href={resource.href} target="_blank" rel="noopener noreferrer" class:list={[
                          "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4",
                          hasBrief
                            ? "inline-flex h-11 w-44 max-w-full items-center justify-center gap-2 rounded-[4px] border px-3 text-sm leading-5 no-underline transition-colors"
                            : "inline-flex max-w-full items-center gap-2 rounded-md bg-ink px-3 py-2.5 text-sm leading-5 text-paper no-underline shadow-sm transition-opacity hover:opacity-80",
                          hasBrief && (resource.label === "Product Brief"
                            ? "border-rule bg-transparent text-ink hover:border-muted"
                            : "border-ink bg-ink text-white hover:bg-ink/80")
                        ]}>
                          {resource.label === "Product Brief" ? (
                            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                              <path d="M7 3h7l4 4v14H7zM14 3v5h5M9.5 13h5M9.5 16h5" />
                            </svg>
                          ) : <span aria-hidden="true" class="text-[10px]">{resource.label.startsWith("Watch Demo") ? "▶" : "↗"}</span>}
                          {resource.label}
                        </a>
                      ))}
                    </div>
                  )}
                  <p class="mt-5 border-t border-rule/60 pt-3 text-[11px] leading-5 text-muted/80">
                    <span class="uppercase tracking-[0.14em]">Tools</span>
                    <span class="mx-2 text-rule" aria-hidden="true">/</span>
                    <span>{project.tools.join(" · ")}</span>
                  </p>
                </div>
              </div>
            </div>
          </article>
          );

          return (
            <div class="group">
              {card}
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="border-b border-rule pb-12 pt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">Experience</h2>
    </div>
    {selectedProjects.map((project) => <ProjectCard {...project} />)}
  </section>

  <section id="writing" class="border-t border-rule py-12" data-nav-section="writing">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">Writing</h2>
    </div>
    <ArticleList articles={writing} />
  </section>

  <section class="border-t border-rule py-12">
    <a
      href="/interview"
      class="group block border border-rule bg-[#fbfaf6]/70 px-5 py-6 no-underline shadow-[0_1px_0_rgba(23,23,23,0.06)] transition duration-200 ease-out hover:-translate-y-1 hover:border-ink hover:bg-[#fcfbf7] hover:shadow-[0_12px_28px_rgba(23,23,23,0.08)]"
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">More About Me</h2>
          <p class="mt-4 max-w-2xl text-xl leading-8 text-ink">Click to Learn More</p>
        </div>
        <span class="flex items-center gap-3 text-sm uppercase tracking-[0.12em] text-muted transition-colors group-hover:text-ink">
          Open
          <span class="h-px w-12 bg-rule transition-all group-hover:w-16 group-hover:bg-ink" aria-hidden="true" />
        </span>
      </div>
    </a>
  </section>
</Layout>

<style>
  .editorial-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
  .hero-portrait { width: 200px; max-width: 100%; }
  .hero-tagline { font-size: 28px; line-height: 1.2; text-wrap: balance; }
  @media (min-width: 640px) {
    .editorial-hero { grid-template-columns: 200px minmax(0, 1fr); gap: 28px; }
    .hero-portrait { width: 200px; }
    .hero-copy { border-left: 1px solid #ded8cf; padding-left: 28px; }
    .hero-tagline { font-size: 28px; }
  }
  @media (min-width: 1024px) {
    .editorial-hero { grid-template-columns: 240px minmax(0, 1fr); gap: 32px; }
    .hero-portrait { width: 240px; }
    .hero-copy { padding-left: 32px; }
    .hero-tagline { font-size: 30px; }
  }
  .project-visual { height: 300px; }
  .project-info { min-height: 360px; }
  @media (min-width: 1024px) {
    .project-visual, .project-info { height: 500px; }
  }
</style>
