---
import Layout from "../components/Layout.astro";
import ArticleList from "../components/ArticleList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing"))
  .sort((a, b) => {
    const aUnpublished = a.data.readingTime === "TBD";
    const bUnpublished = b.data.readingTime === "TBD";

    if (aUnpublished !== bUnpublished) {
      return aUnpublished ? 1 : -1;
    }

    return b.data.date.valueOf() - a.data.date.valueOf();
  });
const selectedProjects = projects.slice(0, 3);
const companyLogos: Record<string, string> = {
  WHOOP: "/images/logos/whoop.png",
  "Uber Freight": "/images/logos/uber.png",
  Instawork: "/images/logos/instawork.png"
};
const projectNotes = [
  {
    title: "WHOOP Experiments",
    image: "/images/projects/whoop-experiments.png",
    carouselImages: [
      { src: "/images/projects/whoop-experiments.png", alt: "WHOOP Experiments overview" },
      { src: "/images/projects/whoop-experiments-coach-suggestion.png", alt: "WHOOP Coach experiment suggestion" },
      { src: "/images/projects/whoop-experiments-setup.png", alt: "WHOOP experiment setup" },
      { src: "/images/projects/whoop-experiments-daily-logging.png", alt: "WHOOP experiment daily logging" }
    ],
    imageFit: "contain",
    experience: "WHOOP",
    description:
      "Designed and prototyped a WHOOP feature that helps members test personalized habits through seven-day challenges, Journal check-ins, and results recaps.",
    tools: ["Codex", "Figma Make", "React", "TypeScript"],
    resources: [
      { label: "Watch Demo", href: "https://www.youtube.com/watch?v=bmqujEWhcxI", primary: true },
      { label: "Product Brief", href: "/documents/whoop-experiments-product-brief.pdf", primary: false }
    ]
  },
  {
    title: "Tracking Page AI Summary",
    slug: "/projects/tracking-page-ai-summary",
    image: "/images/projects/tracking-page-dashboard.png",
    imageFit: "contain",
    experience: "Uber Freight",
    description:
      "An LLM-powered tracking-page experience that turns shipment events, ETA changes, and delay signals into a clear status narrative for customers.",
    tools: ["Figma", "Cursor", "Gemini API", "Tableau"],
    resources: [
      { label: "Watch Demo (2 min)", href: "https://www.youtube.com/watch?v=S9oXYqEwpTY&feature=youtu.be", primary: true },
      { label: "Product Brief", href: "/documents/ptp-ai-summary-prd.pdf", primary: false }
    ]
  },
  {
    title: "Shipment Risk Reasons",
    slug: "/projects/shipment-risk-reasons",
    image: "/images/projects/shipment-risk-dashboard.png",
    imageFit: "contain",
    experience: "Uber Freight",
    description:
      "An AI shipment visibility feature that scrapes carrier comments & shipment data to provide customer-facing explanations for load risk level.",
    tools: ["Nano Banana", "Cursor", "Python", "SQL"],
    resources: [
      { label: "Product Brief", href: "/documents/uber-risk-reasons-brief.pdf", primary: true }
    ]
  },
  {
    title: "Hiring Cost & ROI Calculator",
    image: "/images/projects/hiring-calculator-landing.png",
    carouselImages: [
      { src: "/images/projects/hiring-calculator-landing.png", alt: "Hiring Cost Calculator landing page" },
      { src: "/images/projects/hiring-calculator-inputs.png", alt: "Hiring Cost Calculator hiring inputs" },
      { src: "/images/projects/hiring-calculator-analysis.png", alt: "Hiring Cost Calculator cost analysis and ROI comparison" }
    ],
    experience: "Instawork",
    description:
      "An interactive calculator (gated content) page I ran LinkedIn ads to that helped recruiters understand hiring costs and estimate Instawork’s ROI, while collecting their lead info.",
    tools: ["Replit", "Hubspot", "Google Analytics"],
    resources: [
      { label: "Try Calculator", href: "https://hiringcalculator.instawork.com/", primary: true }
    ]
  },
  {
    title: "Job Posting",
    image: "/images/projects/job-posting-onboarding.png",
    experience: "Instawork",
    description:
      "A redesigned job posting flow that let employers preview listings, see local worker supply, and skip payment and login steps to reduce onboarding friction.",
    tools: ["Replit", "Hubspot", "A/B Testing"],
    resources: [
      { label: "Try Job Posting", href: "https://hiring-job-post-lsilveira2.replit.app/", primary: true },
      { label: "Product Brief", href: "/documents/instawork-job-posting-product-brief.pdf", primary: false }
    ]
  }
];
const projectNoteStyles = [
  {
    paper: "bg-[#fcfbf7]",
    tape: "bg-[#e8e1d6]"
  },
  {
    paper: "bg-[#fbfaf6]",
    tape: "bg-[#ded8cf]"
  },
  {
    paper: "bg-[#fdfbf4]",
    tape: "bg-[#e7ddcb]"
  },
  {
    paper: "bg-[#fbfaf6]",
    tape: "bg-[#e5ded2]"
  }
];
---

<Layout
  title="About"
  description="About Luca Silveira: product manager and business student interested in AI, logistics, marketplaces, global markets, and Brazil."
>
  <section id="about-me" class="editorial-hero" data-nav-section="about" aria-label="About Luca">
    <div class="hero-portrait relative">
      <div class="absolute -left-4 top-4 h-full w-full rounded-[3px] border border-rule" aria-hidden="true" />
      <img
        src="/images/luca-headshot.png"
        alt="Luca Silveira headshot"
        class="relative block h-auto w-full rounded-[3px]"
      />
    </div>
    <div class="hero-copy min-w-0">
      <h1 class="text-[17px] font-medium uppercase tracking-[0.12em] text-ink">Luca Silveira</h1>
      <h2 class="hero-tagline mt-3 font-serif font-normal text-ink">
        From selling boats in Miami to building products at Uber
      </h2>
      <p class="mt-4 text-[18px] leading-[1.5] text-ink">
        I'm a senior at Michigan Ross studying business. This summer, I worked in product at Uber Freight, building AI and tracking features across $20B in freight under management. Previously, I worked on growth at Instawork, a labor marketplace startup, and started a boat dealership in high school. I'm Brazilian-American, grew up in Miami, and played MLS NEXT soccer growing up.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="https://drive.google.com/file/d/1mX4iaF9mPI-bvAcM6TBPuqD2AQYu9aj4/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 text-base font-medium text-ink no-underline hover:text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">
          <span class="underline underline-offset-4">Resume</span><span aria-hidden="true">↗</span>
        </a>
        <a href="https://www.linkedin.com/in/luca-l-silveira/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 text-base font-medium text-ink no-underline hover:text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">
          <span class="underline underline-offset-4">LinkedIn</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section id="projects" class="mt-9 border-t border-ink pb-12 pt-6" data-nav-section="projects">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">My Projects</h2>
    </div>
    <div class="space-y-8">
      {
        projectNotes.map((project, index) => {
          const noteStyle = projectNoteStyles[index % projectNoteStyles.length];
          const hasBrief = project.resources?.some((resource) => resource.label === "Product Brief");
          const card = (
          <article
            data-project-card
            class:list={[
              "relative overflow-hidden border border-rule shadow-[0_1px_0_rgba(23,23,23,0.08),0_18px_38px_rgba(23,23,23,0.08)] transition duration-300 ease-out before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(135deg,rgba(255,255,255,0.72),rgba(255,255,255,0)_38%)] before:content-[''] group-hover:-translate-y-1 group-hover:border-ink group-hover:shadow-[0_1px_0_rgba(23,23,23,0.12),0_24px_48px_rgba(23,23,23,0.12)]",
              noteStyle.paper
            ]}
          >
            <span
              class:list={[
                "pointer-events-none absolute left-8 top-0 z-[2] h-2 w-20 border-x border-b border-rule/70 opacity-85 shadow-[0_4px_10px_rgba(23,23,23,0.06)]",
                noteStyle.tape
              ]}
              aria-hidden="true"
            />
            <div class="project-layout relative z-[1] grid gap-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
              <div class="project-visual relative min-w-0 overflow-hidden border-b border-rule bg-paper lg:border-b-0 lg:border-r">
                {project.carouselImages ? (
                  <div class:list={["whoop-carousel", project.experience === "Instawork" && "calculator-carousel"]} data-project-carousel data-whoop-carousel={project.experience === "WHOOP" ? "" : undefined} data-loop={project.experience === "WHOOP" ? "true" : "false"} tabindex="0" role="region" aria-roledescription="carousel" aria-label={`${project.title} screens`}>
                    <div class="whoop-carousel-track" data-carousel-track>
                      {project.carouselImages.map((slide, slideIndex) => (
                        <div class="whoop-carousel-slide" data-carousel-slide aria-hidden={slideIndex === 0 ? "false" : "true"}>
                          <img
                            src={slide.src}
                            alt={slide.alt}
                            loading={slideIndex === 0 ? "eager" : "lazy"}
                            fetchpriority={slideIndex === 0 ? "high" : "auto"}
                            class:list={slideIndex === 0 && project.experience !== "Instawork" ? ["project-thumbnail", `project-thumbnail-${index}`, "absolute", "transition", "duration-300", "ease-out"] : ["whoop-carousel-image"]}
                          />
                        </div>
                      ))}
                    </div>
                    <button class="whoop-carousel-arrow whoop-carousel-arrow--previous" type="button" data-carousel-previous aria-label={`Previous ${project.title} screen`} disabled>‹</button>
                    <button class="whoop-carousel-arrow whoop-carousel-arrow--next" type="button" data-carousel-next aria-label={`Next ${project.title} screen`}>›</button>
                    <div class="whoop-carousel-pagination" aria-label={`${project.title} screens`}>
                      {project.carouselImages.map((slide, slideIndex) => (
                        <button type="button" data-carousel-dot={slideIndex} aria-label={`Show screen ${slideIndex + 1}: ${slide.alt}`} aria-current={slideIndex === 0 ? "true" : "false"} />
                      ))}
                    </div>
                    <p class="sr-only" aria-live="polite" data-carousel-status>Showing screen 1 of {project.carouselImages.length}: {project.carouselImages[0].alt}</p>
                  </div>
                ) : (
                  <img
                    src={project.image}
                    alt={`${project.title} preview`}
                    class:list={["project-thumbnail absolute transition duration-300 ease-out", `project-thumbnail-${index}`]}
                  />
                )}
                <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(247,244,238,0)_62%,rgba(247,244,238,0.52))] opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />
              </div>
              <div class="project-info relative flex min-w-0 items-center justify-center p-4 sm:p-5">
                <div class="relative w-full min-w-0 border border-rule bg-paper/90 p-4 shadow-[0_1px_0_rgba(23,23,23,0.08),0_14px_30px_rgba(23,23,23,0.08)] backdrop-blur-sm">
                  <div class="mb-2 grid grid-cols-[minmax(0,1fr)_1rem_auto] items-center gap-2">
                    <span title={project.experience === "WHOOP" ? "Independent product concept; not affiliated with WHOOP" : undefined} class:list={["company-badge justify-self-start flex flex-none h-[38px] items-center gap-2 max-w-full rounded-md border border-rule bg-[#fbfaf6] px-2.5 py-1 text-[11px] uppercase tracking-[0.08em] text-muted shadow-[0_1px_0_rgba(23,23,23,0.08),0_6px_18px_rgba(23,23,23,0.04)] sm:tracking-[0.1em]", project.resources ? "min-w-0 whitespace-normal leading-4" : "whitespace-nowrap overflow-hidden text-ellipsis"]}>
                      {companyLogos[project.experience] && (
                        <img class="company-logo" data-company={project.experience} src={companyLogos[project.experience]} alt={project.experience === "Uber Freight" ? "Uber" : project.experience} width={project.experience === "Instawork" ? 90 : project.experience === "WHOOP" ? 66 : 44} height="22" decoding="async" data-company-logo />
                      )}
                      <span class="whitespace-nowrap" data-company-name={project.experience} hidden={!!companyLogos[project.experience] && project.experience !== "Uber Freight"}>{project.experience === "Uber Freight" ? "Freight" : project.experience}</span>
                      {project.experience === "WHOOP" && <span class="sr-only">Independent product concept; not affiliated with WHOOP.</span>}
                    </span>
                    <span class="h-px min-w-0 bg-rule/90" aria-hidden="true" />
                    <span class="flex-none whitespace-nowrap pl-1 text-[11px] uppercase tracking-[0.14em] text-muted">
                      0{index + 1}
                    </span>
                  </div>
                  <h3 class="text-[22px] font-normal leading-tight text-ink">
                    {project.slug && project.resources ? (
                      <a href={project.slug} class="no-underline hover:underline focus-visible:outline focus-visible:outline-offset-4">{project.title}</a>
                    ) : project.title}
                  </h3>
                  <p class="mt-4 text-sm leading-6 text-muted">{project.description}</p>
                  {project.resources && (
                    <div class:list={["mt-5 flex flex-col items-start text-sm text-ink", hasBrief ? "gap-2.5" : "gap-3"]}>
                      {project.resources.map((resource) => (
                        <a href={resource.href} target="_blank" rel="noopener noreferrer" class:list={[
                          "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4",
                          hasBrief
                            ? "inline-flex h-11 w-44 max-w-full items-center justify-center gap-2 rounded-[4px] border px-3 text-sm leading-5 no-underline transition-colors"
                            : "inline-flex max-w-full items-center gap-2 rounded-md bg-ink px-3 py-2.5 text-sm leading-5 text-paper no-underline shadow-sm transition-opacity hover:opacity-80",
                          hasBrief && (resource.label === "Product Brief"
                            ? "border-rule bg-transparent text-ink hover:border-muted"
                            : "border-ink bg-ink text-white hover:bg-ink/80")
                        ]}>
                          {resource.label === "Product Brief" ? (
                            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                              <path d="M7 3h7l4 4v14H7zM14 3v5h5M9.5 13h5M9.5 16h5" />
                            </svg>
                          ) : <span aria-hidden="true" class="text-[10px]">{resource.label.startsWith("Watch Demo") ? "▶" : "↗"}</span>}
                          {resource.label}
                        </a>
                      ))}
                    </div>
                  )}
                  <p class="mt-5 border-t border-rule/60 pt-3 text-[11px] leading-5 text-muted/80">
                    <span class="uppercase tracking-[0.14em]">Tools</span>
                    <span class="mx-2 text-rule" aria-hidden="true">/</span>
                    <span>{project.tools.join(" · ")}</span>
                  </p>
                </div>
              </div>
            </div>
          </article>
          );

          return (
            <div class="group">
              {card}
            </div>
          );
        })
      }
    </div>
  </section>

  <section id="experience" class="border-b border-rule pb-12 pt-12" data-nav-section="experience">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">Experience</h2>
    </div>
    {selectedProjects.map((project) => <ProjectCard {...project} />)}
  </section>

  <section id="writing" class="border-t border-rule py-12" data-nav-section="writing">
    <div class="mb-6">
      <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">Writing</h2>
    </div>
    <ArticleList articles={writing} />
  </section>

  <section class="border-t border-rule py-12">
    <a
      href="/interview"
      class="group block border border-rule bg-[#fbfaf6]/70 px-5 py-6 no-underline shadow-[0_1px_0_rgba(23,23,23,0.06)] transition duration-200 ease-out hover:-translate-y-1 hover:border-ink hover:bg-[#fcfbf7] hover:shadow-[0_12px_28px_rgba(23,23,23,0.08)]"
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-normal uppercase tracking-[0.12em] text-ink">More About Me</h2>
        </div>
        <span class="flex items-center gap-3 text-sm uppercase tracking-[0.12em] text-muted transition-colors group-hover:text-ink">
          Open
          <span class="h-px w-12 bg-rule transition-all group-hover:w-16 group-hover:bg-ink" aria-hidden="true" />
        </span>
      </div>
    </a>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-company-logo]").forEach((image) => {
    const showCompanyName = () => {
      const label = image.parentElement?.querySelector<HTMLElement>("[data-company-name]");
      if (label) {
        label.textContent = label.dataset.companyName ?? "";
        label.hidden = false;
      }
      image.remove();
    };
    image.addEventListener("error", showCompanyName, { once: true });
    if (image.complete && image.naturalWidth === 0) showCompanyName();
  });
  document.querySelectorAll<HTMLElement>("[data-project-card]").forEach((card) => {
    const firstLink = card.querySelector<HTMLAnchorElement>("a[href]");
    if (!firstLink) return;

    const primaryLink = document.createElement("a");
    primaryLink.className = "project-card-primary";
    for (const attribute of ["href", "target", "rel", "download", "referrerpolicy"]) {
      const value = firstLink.getAttribute(attribute);
      if (value !== null) primaryLink.setAttribute(attribute, value);
    }
    const name = card.querySelector("h3")?.textContent?.trim() ?? "Project";
    const destination = firstLink.closest("h3")
      ? "project page"
      : firstLink.textContent?.trim();
    primaryLink.setAttribute("aria-label", `${name}: ${destination}${firstLink.target === "_blank" ? " (opens in a new tab)" : ""}`);
    card.prepend(primaryLink);
  });

  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach((carousel) => {
    const loop = carousel.dataset.loop === "true";
    const card = carousel.closest<HTMLElement>("[data-project-card]");
    const cardLink = card?.querySelector<HTMLAnchorElement>(":scope > .project-card-primary");
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    let activeSlide = 0;
    let startX = 0;
    let startY = 0;
    let didSwipe = false;

    const showSlide = (requestedSlide: number) => {
      const nextSlide = loop && requestedSlide >= slides.length ? 0 : Math.max(0, Math.min(requestedSlide, slides.length - 1));
      activeSlide = nextSlide;
      if (track) track.style.transform = `translateX(-${nextSlide * 100}%)`;
      previous && (previous.disabled = nextSlide === 0);
      next && (next.disabled = !loop && nextSlide === slides.length - 1);
      if (document.activeElement === previous && previous?.disabled) next?.focus({ preventScroll: true });
      if (document.activeElement === next && next?.disabled) previous?.focus({ preventScroll: true });
      slides.forEach((slide, index) => slide.setAttribute("aria-hidden", String(index !== nextSlide)));
      dots.forEach((dot, index) => dot.setAttribute("aria-current", String(index === nextSlide)));
      const image = slides[nextSlide]?.querySelector<HTMLImageElement>("img");
      if (status && image) status.textContent = `Showing screen ${nextSlide + 1} of ${slides.length}: ${image.alt}`;
    };

    previous?.addEventListener("click", (event) => { event.stopPropagation(); showSlide(activeSlide - 1); });
    next?.addEventListener("click", (event) => { event.stopPropagation(); showSlide(activeSlide + 1); });
    dots.forEach((dot, index) => dot.addEventListener("click", (event) => { event.stopPropagation(); showSlide(index); }));

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); showSlide(activeSlide - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); showSlide(activeSlide + 1); }
      if (event.key === "Home") { event.preventDefault(); showSlide(0); }
      if (event.key === "End") { event.preventDefault(); showSlide(slides.length - 1); }
    });

    carousel.addEventListener("pointerdown", (event) => {
      startX = event.clientX;
      startY = event.clientY;
      didSwipe = false;
    });
    carousel.addEventListener("pointerup", (event) => {
      const horizontalDistance = event.clientX - startX;
      const verticalDistance = event.clientY - startY;
      if (Math.abs(horizontalDistance) < 40 || Math.abs(horizontalDistance) <= Math.abs(verticalDistance)) return;
      didSwipe = true;
      showSlide(activeSlide + (horizontalDistance < 0 ? 1 : -1));
    });
    carousel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("button")) return;
      if (!didSwipe) cardLink?.click();
      didSwipe = false;
    });

    showSlide(0);
  });
</script>

<style>
  .company-logo { width: auto; height: 22px; max-width: 100%; min-width: 0; flex: 0 1 auto; object-fit: contain; }
  .company-logo[data-company="WHOOP"] { height: 20px; }
  .company-logo[data-company="Instawork"] { height: 24px; }
  [data-project-card]:has(> .project-card-primary) { cursor: pointer; }
  [data-project-card] :global(.project-card-primary) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  [data-project-card]:has(> .project-card-primary:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  /* Let the native card link receive background clicks without covering existing links. */
  [data-project-card]:has(> .project-card-primary) .project-layout { pointer-events: none; }
  [data-project-card] .project-layout a { pointer-events: auto; }
  .whoop-carousel { position: relative; z-index: 1; width: 100%; height: 100%; overflow: hidden; pointer-events: auto; touch-action: pan-y; }
  .whoop-carousel:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
  .whoop-carousel-track { display: flex; width: 100%; height: 100%; transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  .whoop-carousel-slide { position: relative; flex: 0 0 100%; width: 100%; height: 100%; overflow: hidden; }
  .whoop-carousel-image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .calculator-carousel .whoop-carousel-track { transition-duration: 250ms; }
  .calculator-carousel .whoop-carousel-image { object-fit: contain; padding: 12px 12px 36px; }
  .whoop-carousel-arrow { position: absolute; z-index: 2; top: 50%; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid rgba(38, 38, 38, 0.26); border-radius: 999px; color: #282828; font-size: 26px; background: rgba(252, 251, 247, 0.9); box-shadow: 0 2px 10px rgba(23, 23, 23, 0.12); cursor: pointer; opacity: 0; transform: translateY(-50%); transition: opacity 200ms ease-out, transform 200ms ease-out, background-color 200ms ease-out, visibility 200ms ease-out; }
  .whoop-carousel-arrow--previous { left: 12px; }
  .whoop-carousel-arrow--next { right: 12px; }
